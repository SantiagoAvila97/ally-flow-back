PORT=3000
# En producción: obligatorio, ≥32 chars, distinto del valor de desarrollo.
JWT_SECRET=ally-flow-dev-secret-change-in-production
JWT_EXPIRES_IN=8h
JWT_ISSUER=ally-flow
JWT_AUDIENCE=ally-flow-api

# Orígenes front (coma). PROD: solo la URL fija de Vercel Production.
# LOCAL/QA: añaden localhost:4200 y permiten *.vercel.app (previews) en código.
CORS_ORIGIN=http://localhost:4200

NODE_ENV=development
# Docker/Railway: obligatorio qa|prod (sin default silencioso a prod).
# Local: dev (o vacío).
APP_ENV=dev

# AUTH_RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Postgres (Neon) — LOCAL DEBE usar la misma DATABASE_URL que Railway QA.
# Copia Variables → DATABASE_URL del servicio ally-flow-back-qa y reinicia el API.
# Vacío = modo in-memory (NO usar en el día a día; datos se pierden al reiniciar).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL=true
# En PROD el seed demo no corre salvo:
# SEED_DEMO=true

# SUPER_ADMIN — LOCAL/QA: defaults de prueba si no defines vars.
# PROD: SUPER_ADMIN_EMAIL y SUPER_ADMIN_PASSWORD son OBLIGATORIOS (sin default en código).
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NOMBRE=

# GOOGLE_MAPS_API_KEY=
