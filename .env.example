PORT=3000
# En producción: obligatorio, ≥32 chars, distinto del valor de desarrollo.
JWT_SECRET=ally-flow-dev-secret-change-in-production
# Vigencia del access token (turno ~8h). Tras expirar → re-login.
JWT_EXPIRES_IN=8h
JWT_ISSUER=ally-flow
JWT_AUDIENCE=ally-flow-api
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development
# dev | qa | prod
APP_ENV=dev

# Postgres (Neon). Vacío = modo in-memory.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL=true
# En PROD el seed demo no corre salvo:
# SEED_DEMO=true

# SUPER_ADMIN (plataforma /suite) — defaults por APP_ENV:
#   PROD → saviladev@allyflow.app / Oldkfrj00utw+
#   QA/dev → superadmin.qa@allyflow.app / QaSuperAdmin#2026!
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NOMBRE=

# Opcional — Geocoding exacto de Google
# GOOGLE_MAPS_API_KEY=
