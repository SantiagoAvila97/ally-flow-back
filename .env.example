PORT=3000
# En producción: obligatorio, ≥32 chars, distinto del valor de desarrollo.
JWT_SECRET=ally-flow-dev-secret-change-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development
# dev | qa | prod
APP_ENV=dev

# Postgres (Neon / Railway). Vacío = modo in-memory local.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL=true

# Opcional — Geocoding exacto de Google
# GOOGLE_MAPS_API_KEY=
